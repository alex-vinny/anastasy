# Copy to .env and paste your ADO.NET connection strings (one per line).
# Optional per-connection suffixes: <NAME>_READONLY=true|false and <NAME>_PROD=true|false.
# Without a suffix, readonly/prod are inferred (a *reader* user, or a db/server
# whose name contains prd|prod|pro-).

# Connection with an inline password:
HML=Data Source=your-server.database.windows.net;Initial Catalog=your_db_hml;User Id=<user>;Password=<pwd>;Encrypt=true;TrustServerCertificate=true

# Connection WITHOUT Password= — uses a session password resolved at connect time
# (DBQ_PASSWORD env var, `auth` cache, or an interactive prompt). Nothing sits on disk.
PRD=Data Source=your-server.database.windows.net;Initial Catalog=your_db_prd;User Id=<user>;Encrypt=true;TrustServerCertificate=true
PRD_PROD=true
PRD_READONLY=false

# Read-only production example:
# PRDRO=Data Source=your-server.database.windows.net;Initial Catalog=your_db_prd;User Id=reader;Password=<pwd>;Encrypt=true;TrustServerCertificate=true
# PRDRO_READONLY=true
# PRDRO_PROD=true
