# Copy to .env and paste your ADO.NET connection strings (one per line).
# Optional per-connection suffixes: <NAME>_READONLY=true|false, <NAME>_PROD=true|false,
# and <NAME>_DESC=<free text> (shown by `dbq conns` to explain what the connection is).
# Without a suffix, readonly/prod are inferred (a *reader* user, or a db/server
# whose name contains prd|prod|pro-).

# Connection with an inline password:
HML=Data Source=your-server.database.windows.net;Initial Catalog=your_db_hml;User Id=<user>;Password=<pwd>;Encrypt=true;TrustServerCertificate=true

# Connection WITHOUT Password= — uses a session password resolved at connect time
# (DBQ_PASSWORD env var, `auth` cache, or an interactive prompt). Nothing sits on disk.
PRD=Data Source=your-server.database.windows.net;Initial Catalog=your_db_prd;User Id=<user>;Encrypt=true;TrustServerCertificate=true
PRD_PROD=true
PRD_READONLY=false

# Read-only production example:
# PRDRO=Data Source=your-server.database.windows.net;Initial Catalog=your_db_prd;User Id=reader;Password=<pwd>;Encrypt=true;TrustServerCertificate=true
# PRDRO_READONLY=true
# PRDRO_PROD=true

# Azure AD / Entra ID with your OWN user (MFA in the browser, once per device; no password anywhere).
# Authentication= accepts: Active Directory Interactive | Active Directory Device Code | Active Directory Default.
# User Id= is only a login hint; Tenant Id= is optional (defaults to "organizations").
# Sign in with `dbq auth DEVAAD` (add --device for the device-code flow); the token is cached
# in dbq.sqlite and renewed silently through the persisted MSAL cache. DBQ_TOKEN env var overrides.
DEVAAD=Data Source=your-server.database.windows.net;Initial Catalog=your_db_dev;Authentication=Active Directory Interactive;User Id=you@company.com;Encrypt=true;TrustServerCertificate=true

# Active Directory Default = DefaultAzureCredential (az login / Azure PowerShell / env / managed identity):
# DEVCLI=Data Source=your-server.database.windows.net;Initial Catalog=your_db_dev;Authentication=Active Directory Default;Encrypt=true;TrustServerCertificate=true
